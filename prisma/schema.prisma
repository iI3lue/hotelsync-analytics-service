generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OccupancyDaily {
  hotel_id         String   @db.Uuid
  date             DateTime @db.Date
  available_nights Int
  occupied_nights  Int
  occupancy        Decimal  @db.Decimal(5, 4) // 0–1

  @@id([hotel_id, date])
  @@map("occupancy_daily")
}

model KpiByProperty {
  hotel_id   String   @db.Uuid
  date       DateTime @db.Date
  adr        Decimal  @db.Decimal(12, 2)
  revpar     Decimal  @db.Decimal(12, 2)
  rooms_sold Int
  revenue    Decimal  @db.Decimal(12, 2)

  @@id([hotel_id, date])
  @@map("kpi_by_property")
}

/**
 * Evento de dominio encolado dentro de la misma transacción que el agregado
 * (patrón outbox del monorepo): `pending` → dispatcher publica → `sent`.
 */
model EventOutbox {
  event_id   String    @id @default(uuid()) @db.Uuid
  event_type String    @db.VarChar(50)
  payload    Json      @db.Json
  status     String    @default("pending") @db.VarChar(20)
  attempts   Int       @default(0)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  sent_at    DateTime? @db.Timestamptz(6)

  @@index([status, created_at])
  @@map("event_outbox")
}
