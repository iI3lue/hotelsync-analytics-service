NODE_ENV=development
PORT=3011
# Base propia del servicio (migraciones + agregados). En produccion: Neon analytics_db.
DATABASE_URL=postgresql://hotelsync:analytics_dev@localhost:5442/analytics_db
# Replicas de SOLO LECTURA de booking y property (roles read-only en produccion).
DATABASE_URL_BOOKING=postgresql://hotelsync:booking_dev@localhost:5434/booking_db
DATABASE_URL_PROPERTY=postgresql://hotelsync:property_dev@localhost:5432/property_db
# OBLIGATORIO: identico al AUTH_JWT_SECRET de user-service.
AUTH_JWT_SECRET=change-me-to-user-service-secret-min-32-chars
# Sin RABBITMQ_URL el outbox queda `pending` y la operacion no se interrumpe.
RABBITMQ_URL=amqp://localhost:5672
# Corrida programada del ETL. Sin datos: cada 6 h, arranca a los 30 s, ventana de 7 dias.
# ETL_INTERVAL_MS=21600000
# ETL_START_DELAY_MS=30000
# ETL_LOOKBACK_DAYS=7
